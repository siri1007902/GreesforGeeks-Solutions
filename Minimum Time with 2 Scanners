class Solution {
  public:
    long long minTime(int n, int s1, int s2) {
        long long low = 0;
        long long high = 1LL * n * min(s1, s2);

        while (low < high) {
            long long mid = low + (high - low) / 2;

            long long documents = mid / s1 + mid / s2;

            if (documents >= n) {
                high = mid;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
};
