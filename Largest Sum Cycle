class Solution {
public:
    long long largestSumCycle(vector<int>& edge) {
        int n = edge.size();

        vector<int> visited(n, 0);
        long long ans = -1;

        for (int i = 0; i < n; i++) {
            if (visited[i])
                continue;

            unordered_map<int, int> path;
            int node = i;

            while (node != -1 && !visited[node]) {
                visited[node] = 1;
                path[node] = path.size();
                node = edge[node];
            }

            if (node != -1 && path.find(node) != path.end()) {
                long long sum = 0;
                int curr = node;

                do {
                    sum += curr;
                    curr = edge[curr];
                } while (curr != node);

                ans = max(ans, sum);
            }
        }

        return ans;
    }
};
