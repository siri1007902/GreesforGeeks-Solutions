class Solution {
public:
    vector<string> generateUsernames(vector<string>& arr) {
        unordered_set<string> used;
        unordered_set<string> processed;
        unordered_map<string, int> nextSuffix;

        for (auto &s : arr) {
            used.insert(s);
        }

        vector<string> ans;

        for (auto &s : arr) {
            if (processed.find(s) == processed.end()) {
                processed.insert(s);
                ans.push_back(s);
            }
            else {
                int k = max(1, nextSuffix[s]);

                while (used.count(s + to_string(k))) {
                    k++;
                }

                string newName = s + to_string(k);

                used.insert(newName);
                nextSuffix[s] = k + 1;

                ans.push_back(newName);
            }
        }

        return ans;
    }
};
