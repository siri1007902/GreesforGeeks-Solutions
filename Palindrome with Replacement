class Solution {
public:
    int minimumSum(string s) {
        int n = s.size();

        for (int i = 0; i < n / 2; i++) {
            int j = n - 1 - i;

            if (s[i] != '?' && s[j] != '?' &&
                s[i] != s[j]) {
                return -1;
            }

            if (s[i] == '?')
                s[i] = s[j];

            if (s[j] == '?')
                s[j] = s[i];
        }

        int cost = 0;
        char last = '?';

        for (int i = 0; i < (n + 1) / 2; i++) {
            if (s[i] == '?')
                continue;

            if (last != '?')
                cost += abs(s[i] - last);

            last = s[i];
        }

        return cost * 2;
    }
};
