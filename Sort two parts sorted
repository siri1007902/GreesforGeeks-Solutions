class Solution {
  public:
    void mergeTwoParts(vector<int>& arr) {
        int n = arr.size();
        int bp = -1;
        for (int i = 1; i < n; i++) {
            if (arr[i] < arr[i - 1]) {
                bp = i;
                break;
            }
        }
        if (bp == -1)
            return;

        vector<int> res;
        int i = 0, j = bp;
        while (i < bp && j < n) {
            if (arr[i] <= arr[j])
                res.push_back(arr[i++]);
            else
                res.push_back(arr[j++]);
        }

        while (i < bp)
            res.push_back(arr[i++]);

        while (j < n)
            res.push_back(arr[j++]);

        arr = res;
    }
};
