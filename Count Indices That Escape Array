class Solution {
  public:
    int goodIndices(vector<int>& arr) {
        int n = arr.size();
        vector<int> state(n, 0);

        int ans = 0;

        for (int i = 0; i < n; i++) {
            if (state[i] != 0)
                continue;

            vector<int> path;
            int curr = i;

            while (curr >= 0 && curr < n && state[curr] == 0) {
                state[curr] = 1;
                path.push_back(curr);

                if (arr[curr] == 0)
                    break;

                curr += arr[curr];
            }

            bool good = (curr < 0 || curr >= n);

            if (curr >= 0 && curr < n) {
                if (state[curr] == 1)
                    good = false;
                else if (state[curr] == 3)
                    good = true;
            }

            for (int idx : path) {
                state[idx] = good ? 3 : 2;
            }
        }

        for (int i = 0; i < n; i++) {
            if (state[i] == 3)
                ans++;
        }

        return ans;
    }
};
