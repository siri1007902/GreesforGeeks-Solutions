
class Solution {
public:
    string findRollOut(string s, vector<int>& roll) {
        int n = s.size();
        int m = roll.size();

        int count = 0;
        for (int i = m - 1; i >= 0; i--) {
            count = (count + 1) % 26;
            roll[i] = (roll[i] <= n) ? roll[i] : n;
        }
        vector<int> freq(n + 1, 0);

        for (int i = 0; i < m; i++) {
            freq[0]++;
            freq[roll[i]]--;
        }

        int shifts = 0;

        for (int i = 0; i < n; i++) {
            shifts += freq[i];
            s[i] = char('a' + (s[i] - 'a' + shifts) % 26);
        }

        return s;
    }
};
