class Solution {
  public:
    vector<vector<int>> socialNetwork(vector<int>& arr) {
        // code here
                int n = arr.size() + 1;
                vector<vector<int>> ans;

                for (int i = 2; i <= n; i++) {
                    // distance[j] = number of links from i to j
                    vector<int> distance(i, -1);

                    int current = i;
                    int steps = 0;

                    while (current != 1) {
                        current = arr[current - 2];
                        steps++;
                        distance[current] = steps;
                    }

                    // IMPORTANT: j must be in increasing order
                    for (int j = 1; j < i; j++) {
                        if (distance[j] != -1) {
                            ans.push_back({i, j, distance[j]});
                        }
                    }
                }

                return ans;
            }
        };
