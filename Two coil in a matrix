class Solution {
  public:
    vector<vector<int>> formCoils(int n) {
        // code here
                int m = 4 * n;
                vector<vector<int>> ans(2);

                int dr[2][4] = {
                    {1, 0, -1, 0},   // down, right, up, left
                    {-1, 0, 1, 0}    // up, left, down, right
                };

                int dc[2][4] = {
                    {0, 1, 0, -1},
                    {0, -1, 0, 1}
                };

                for (int coil = 0; coil < 2; coil++) {
                    int r = coil == 0 ? 0 : m - 1;
                    int c = coil == 0 ? 0 : m - 1;
                    int d = 0;

                    ans[coil].push_back(r * m + c + 1);

                    // First segment
                    int len = m - 1;

                    for (int i = 0; i < len; i++) {
                        r += dr[coil][d];
                        c += dc[coil][d];
                        ans[coil].push_back(r * m + c + 1);
                    }

                    d = 1;

                    // Remaining segments, in pairs
                    for (len = m - 2; len > 0; len -= 2) {
                        for (int j = 0; j < 2; j++) {
                            for (int i = 0; i < len; i++) {
                                r += dr[coil][d];
                                c += dc[coil][d];
                                ans[coil].push_back(r * m + c + 1);
                            }
                            d = (d + 1) % 4;
                        }
                    }
                }

                return ans;
            }
        };
